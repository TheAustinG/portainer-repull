{
  "name": "portainer-repull",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Firefox add-on that lists Portainer stacks and redeploys one with a fresh image pull.",
  "license": "MIT",
  "scripts": {
    "dev": "wxt -b firefox --mv3",
    "build": "wxt build -b firefox --mv3",
    "zip": "wxt zip -b firefox --mv3",
    "lint": "web-ext lint --source-dir .output/firefox-mv3",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.0.4",
    "web-ext": "10.8.0",
    "wxt": "0.21.4"
  }
}
